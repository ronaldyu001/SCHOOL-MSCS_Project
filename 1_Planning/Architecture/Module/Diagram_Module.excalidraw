    {"id":"scope","type":"rectangle","x":20,"y":90,"width":285,"height":730,"angle":0,"strokeColor":"#495057","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"a002","roundness":{"type":3},"seed":71002,"version":1,"versionNonce":81002,"isDeleted":false,"boundElements":[],"updated":1790099900000,"link":null,"locked":false},
    {"id":"scope_t","type":"text","x":40,"y":115,"width":245,"height":420,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"a003","roundness":null,"seed":71003,"version":1,"versionNonce":81003,"isDeleted":false,"boundElements":[],"updated":1790099900000,"link":null,"locked":false,"text":"Diagram scope\n\nThe research harness supports dataset setup, query-rewriter training, evaluation, and result comparison.\n\nThe structure follows the Maia convention:\n\nApplication owns use cases, ports, schemas, and errors.\n\nInfrastructure owns technology-specific adapters.\n\nDomain owns core research entities and policies.\n\nThe frontend remains a thin interface; backend modules own behavior.","fontSize":15,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Diagram scope\n\nThe research harness supports dataset setup, query-rewriter training, evaluation, and result comparison.\n\nThe structure follows the Maia convention:\n\nApplication owns use cases, ports, schemas, and errors.\n\nInfrastructure owns technology-specific adapters.\n\nDomain owns core research entities and policies.\n\nThe frontend remains a thin interface; backend modules own behavior.","autoResize":false,"lineHeight":1.35},
